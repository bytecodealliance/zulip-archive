    {
        "content": "<p><span aria-label=\"memo\" class=\"emoji emoji-1f4dd\" role=\"img\" title=\"memo\">:memo:</span> fitzgen submitted <a href=\"https://github.com/bytecodealliance/wasmtime/pull/15173#pullrequestreview-5806056159\">PR review</a>.</p>",
