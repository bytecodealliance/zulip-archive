><span class=\"w\"> </span><span class=\"mf\">0.0001</span><span class=\"p\">)</span>\n\n<span class=\"w\">    </span><span class=\"err\">┌────────────┬────────────┬───────────────┬───────────────┬────────┬──────────────────────────────┐</span>\n<span class=\"w\">    </span><span class=\"err\">│</span><span class=\"w\"> </span><span class=\"n\">Min</span><span class=\"w\">        </span><span class=\"err\">│</span><span class=\"w\"> </span><span class=\"n\">Max</span><span class=\"w\">        </span><span class=\"err\">│</span><span class=\"w\"> </span><span class=\"n\">Mean</span><span class=\"w\">          </span><span class=\"err\">│</span><span class=\"w\"> </span><span class=\"n\">Median</span><span class=\"w\">        </span><span class=\"err\">│</span><span class=\"w\"> </span><span class=\"n\">Noise</span><span class=\"w\">  </span><span class=\"err\">│</span><span class=\"w\"> </span><span class=\"n\">Engine</span><span class=\"w\">                       </span><span class=\"err\">│</span>\n<span class=\"w\">    </span><span class=\"err\">├────────────┼────────────┼───────────────┼───────────────┼────────┼──────────────────────────────┤</span>\n<span class=\"w\">    </span><span class=\"err\">│</span><span class=\"w\"> </span><span class=\"mi\">156815386</span><span class=\"w\">  </span><span class=\"err\">│</span><span class=\"w\"> </span><span class=\"mi\">183006652</span><span class=\"w\">  </span><span class=\"err\">│</span><span class=\"w\"> </span><span class=\"mf\">162831928.91</span><span class=\"w\">  </span><span class=\"err\">│</span><span class=\"w\"> </span><span class=\"mf\">161767696.00</span><span class=\"w\">  </span><span class=\"err\">│</span><span class=\"w\"> </span><span class=\"mf\">1.037</span><span class=\"o\">%</span><span class=\"w\"> </span><span class=\"err\">│</span><span class=\"w\"> </span><span class=\"n\">lazy</span><span class=\"o\">-</span><span class=\"n\">lenders</span><span class=\"o\">/</span><span class=\"n\">libengine</span><span class=\"p\">.</span><span class=\"n\">dylib</span><span class=\"w\"> </span><span class=\"err\">│</span>\n<span class=\"w\">    </span><span class=\"err\">├────────────┼────────────┼───────────────┼───────────────┼────────┼──────────────────────────────┤</span>\n<span class=\"w\">    </span><span class=\"err\">│</span><span class=\"w\"> </span><span class=\"mi\">1170592107</span><span class=\"w\"> </span><span class=\"err\">│</span><span class=\"w\"> </span><span class=\"mi\">1302149964</span><span class=\"w\"> </span><span class=\"err\">│</span><span class=\"w\"> </span><span class=\"mf\">1210932378.38</span><span class=\"w\"> </span><span class=\"err\">│</span><span class=\"w\"> </span><span class=\"mf\">1206847175.00</span><span class=\"w\"> </span><span class=\"err\">│</span><span class=\"w\"> </span><span class=\"mf\">2.839</span><span class=\"o\">%</span><span class=\"w\"> </span><span class=\"err\">│</span><span class=\"w\"> </span><span class=\"n\">main</span><span class=\"o\">/</span><span class=\"n\">libengine</span><span class=\"p\">.</span><span class=\"n\">dylib</span><span class=\"w\">         </span><span class=\"err\">│</span>\n<span class=\"w\">    </span><span class=\"err\">└────────────┴────────────┴───────────────┴───────────────┴────────┴──────────────────────────────┘</span>\n\n<span class=\"n\">compilation</span><span class=\"w\"> </span><span class=\"p\">::</span><span class=\"w\"> </span><span class=\"nc\">instructions</span><span class=\"o\">-</span><span class=\"n\">retired</span><span class=\"w\"> </span><span class=\"p\">::</span><span class=\"w\"> </span><span class=\"nc\">cm</span><span class=\"o\">-</span><span class=\"n\">online</span><span class=\"o\">-</span><span class=\"n\">stats</span>\n\n<span class=\"w\">    </span><span class=\"n\">main</span><span class=\"o\">/</span><span class=\"n\">libengine</span><span class=\"p\">.</span><span class=\"n\">dylib</span><span class=\"w\"> </span><span class=\"n\">is</span><s