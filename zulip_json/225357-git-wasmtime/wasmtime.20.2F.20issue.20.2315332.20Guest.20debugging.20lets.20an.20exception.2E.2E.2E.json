/span> <span class=\"err\">u</span><span class=\"mi\">32</span><span class=\"p\">)</span> <span class=\"p\">(</span><span class=\"k\">result</span> <span class=\"p\">(</span><span class=\"err\">own</span> <span class=\"nv\">$t</span><span class=\"p\">))))))</span>\n    <span class=\"p\">(</span><span class=\"err\">core</span> <span class=\"k\">func</span> <span class=\"nv\">$new</span> <span class=\"p\">(</span><span class=\"err\">canon</span> <span class=\"err\">lower</span> <span class=\"p\">(</span><span class=\"k\">func</span> <span class=\"nv\">$a</span> <span class=\"s2\">\"new\"</span><span class=\"p\">)))</span>\n    <span class=\"p\">(</span><span class=\"err\">alias</span> <span class=\"k\">export</span> <span class=\"nv\">$a</span> <span class=\"s2\">\"t\"</span> <span class=\"p\">(</span><span class=\"k\">type</span> <span class=\"nv\">$t</span><span class=\"p\">))</span>\n    <span class=\"p\">(</span><span class=\"err\">core</span> <span class=\"k\">func</span> <span class=\"nv\">$t.drop</span> <span class=\"p\">(</span><span class=\"err\">canon</span> <span class=\"err\">resource.</span><span class=\"nb\">drop</span> <span class=\"nv\">$t</span><span class=\"p\">))</span>\n    <span class=\"p\">(</span><span class=\"err\">core</span> <span class=\"k\">module</span> <span class=\"nv\">$b</span>\n      <span class=\"p\">(</span><span class=\"k\">import</span> <span class=\"s2\">\"\"</span> <span class=\"s2\">\"new\"</span> <span class=\"p\">(</span><span class=\"k\">func</span> <span class=\"nv\">$new</span> <span class=\"p\">(</span><span class=\"k\">param</span> <span class=\"kt\">i32</span><span class=\"p\">)</span> <span class=\"p\">(</span><span class=\"k\">result</span> <span class=\"kt\">i32</span><span class=\"p\">)))</span>\n      <span class=\"p\">(</span><span class=\"k\">import</span> <span class=\"s2\">\"\"</span> <span class=\"s2\">\"t.drop\"</span> <span class=\"p\">(</span><span class=\"k\">func</span> <span class=\"nv\">$t.drop</span> <