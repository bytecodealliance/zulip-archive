[
    {
        "content": "<p>xia-chao opened <a href=\"https://github.com/bytecodealliance/wasmtime/pull/14784\">PR #14784</a> from <code>xia-chao:wasi-http-get-body-framing</code> to <code>bytecodealliance:main</code>:</p>\n<blockquote>\n<p>An outgoing GET, HEAD or CONNECT request dropped its body. The host now adds transfer-encoding: chunked, which hyper requires for those methods.<br>\n</p>\n</blockquote>",
        "id": 632331313,
        "sender_full_name": "Wasmtime GitHub notifications bot",
        "timestamp": 1792172290
    },
