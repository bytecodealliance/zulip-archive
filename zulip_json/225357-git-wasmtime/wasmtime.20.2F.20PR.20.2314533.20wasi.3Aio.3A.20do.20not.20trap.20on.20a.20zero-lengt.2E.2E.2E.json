    {
        "content": "<p>github-actions[bot] added the label <code>wasi</code> on <a href=\"https://github.com/bytecodealliance/wasmtime/pull/14533\">PR #14533</a>.</p>",
        "id": 629252092,
        "sender_full_name": "Wasmtime GitHub notifications bot",
