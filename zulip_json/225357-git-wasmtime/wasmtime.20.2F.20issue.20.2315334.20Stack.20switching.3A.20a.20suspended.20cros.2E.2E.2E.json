 <span class=\"p\">(</span><span class=\"nb\">drop</span> <span class=\"p\">(</span><span class=\"nb\">call</span> <span class=\"nv\">$f</span> <span class=\"p\">(</span><span class=\"nb\">call</span> <span class=\"nv\">$new</span> <span class=\"p\">(</span><span class=\"nb\">i32.const</span> <span class=\"mi\">11</span><span class=\"p\">))</span> <span class=\"p\">(</span><span class=\"nb\">call</span> <span class=\"nv\">$t.new</span> <span class=\"p\">(</span><span class=\"nb\">i32.const</span> <span class=\"mi\">0</span><span class=\"p\">)))))</span>\n    <span class=\"p\">(</span><span class=\"k\">elem</span> <span class=\"err\">declare</span> <span class=\"k\">func</span> <span class=\"nv\">$suspend</span> <span class=\"nv\">$resume-then-drop</span> <span class=\"nv\">$body</span><span class=\"p\">)</span>\n    <span class=\"p\">(</span><span class=\"k\">func</span> <span class=\"p\">(</span><span class=\"k\">export</span> <span class=\"s2\">\"run\"</span><span class=\"p\">)</span> <span class=\"p\">(</span><span class=\"k\">result</span> <span class=\"kt\">i32</span><span class=\"p\">)</span>\n      <span class=\"c1\">;; Start `f(a)` on a continuation and suspend it from `t`'s destructor.</span>\n      <span class=\"p\">(</span><span class=\"err\">table.set</span> <span class=\"p\">(</span><span class=\"nb\">i32.const</span> <span class=\"mi\">0</span><span class=\"p\">)</span> <span class=\"p\">(</span><span class=\"err\">ref.</span><span class=\"k\">func</span> <span class=\"nv\">$suspend</span><span class=\"p\">))</span>\n      <span class=\"p\">(</span><span class=\"k\">block</span> <span class=\"nv\">$on</span> <span class=\"p\">(</span><span class=\"k\">result</span> <span class=\"p\">(</span><span class=\"err\">ref</span> <span class=\"nv\">$ct</span><span class=\"p\">))</span>\n        <span class=\"p\">(</span><span class=\"err\">resume</span> <span class=\"nv\">$ct</span> <span class=\"p\">(</span><span class=\"err\">on</span> <span class=\"nv\">$tag