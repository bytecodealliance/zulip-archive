    },
    {
        "content": "<p>theotherjimmy <a href=\"https://github.com/bytecodealliance/wasmtime/pull/14772#issuecomment-6581494963\">commented</a> on <a href=\"https://github.com/bytecodealliance/wasmtime/pull/14772\">PR #14772</a>:</p>\n<blockquote>\n<p>Please excuse me pushing a middle state by mistake. It should be ready for re-review. I've moved more of logic (offsets) into isle and implemented PLT for function references instead of GOT.</p>\n</blockquote>",
        "id": 636930795,
        "sender_full_name": "Wasmtime GitHub notifications bot",
