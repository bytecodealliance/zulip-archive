    {
        "content": "<p>github-actions[bot] added the label <code>wasi</code> on <a href=\"https://github.com/bytecodealliance/wasmtime/pull/14800\">PR #14800</a>.</p>",
        "id": 632939401,
        "sender_full_name": "Wasmtime GitHub notifications bot",
